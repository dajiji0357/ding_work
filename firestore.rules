rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasLinkedUserDoc() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/work_manager_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/work_manager_users/$(request.auth.uid)).data.firebaseUid == request.auth.uid;
    }

    match /work_manager_users/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.firebaseUid == request.auth.uid;
      allow update, delete: if hasLinkedUserDoc();
    }

    match /work_manager_tasks/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasLinkedUserDoc();
    }

    match /work_manager_brands/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasLinkedUserDoc();
    }

    match /work_manager_gym_mood/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasLinkedUserDoc();
    }

    match /work_manager_memos/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasLinkedUserDoc();
    }

    match /work_manager_config/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasLinkedUserDoc();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
